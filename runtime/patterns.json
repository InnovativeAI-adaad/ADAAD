{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADAAD Mutation Pattern Performance Store",
  "description": "Schema and persisted records used to calibrate mutation strategy weighting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "context",
          "success_rate",
          "sample_size",
          "last_used_at"
        ],
        "properties": {
          "pattern_id": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "success_rate": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "sample_size": {
            "type": "integer",
            "minimum": 0
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
