"""
Dork — Easiest access to ADAADinside™ Developer Intelligence.
Ensures server is running and provides CLI and browser access to Dork.
"""

import os
import subprocess
import sys
import time
import webbrowser
import json
import argparse
import http.client
from pathlib import Path

PORT = int(os.getenv("ADAAD_PORT", "8000"))
URL = f"http://localhost:{PORT}/dork"

def is_server_running():
    import socket
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('127.0.0.1', PORT)) == 0

def start_server():
    print(f"[*] Starting ADAAD unified server on port {PORT}...")
    env = os.environ.copy()
    env["ADAAD_ENV"] = "dev"
    env["ADAAD_PORT"] = str(PORT)
    env["ADAAD_HOST"] = "0.0.0.0"
    with open("server.log", "a") as log_file:
        subprocess.Popen(
            [sys.executable, "server.py"],
            env=env,
            stdout=log_file,
            stderr=log_file,
            preexec_fn=os.setpgrp
        )
    
    for _ in range(15):
        if is_server_running():
            print("[+] Server is live.")
            return True
        time.sleep(1)
    return False

def get_api_health():
    try:
        conn = http.client.HTTPConnection("localhost", PORT)
        conn.request("GET", "/api/health")
        resp = conn.getresponse()
        if resp.status == 200:
            return json.loads(resp.read().decode())
    except:
        pass
    return None

def show_status():
    print(f"--- dork status ---")
    running = is_server_running()
    print(f"Server: {'RUNNING' if running else 'STOPPED'}")
    if running:
        health = get_api_health()
        if health:
            print(f"Version: {health.get('version', 'unknown')}")
            print(f"Gate: {'LOCKED' if health.get('gate', {}).get('locked') else 'OPEN'}")
            print(f"UI: {'PRESENT' if health.get('ui_present') else 'MISSING'}")
        print(f"URL: {URL}")
    else:
        print(f"Run 'dork' without arguments to start the server.")

def list_knowledge():
    kb_path = Path("ui/developer/ADAADdev/dork_knowledge_base.js")
    if not kb_path.exists():
        print("[-] Knowledge base not found.")
        return

    content = kb_path.read_text()
    # Very crude extraction of keys from JS object
    import re
    keys = re.findall(r'"([^"]+)":', content)
    print("--- dork knowledge keys ---")
    for k in sorted(keys):
        print(f" - {k}")

def ask_dork(query):
    # Dork knowledge base is static, so we can just read it if it's a simple match
    kb_path = Path("ui/developer/ADAADdev/dork_knowledge_base.js")
    if kb_path.exists():
        content = kb_path.read_text()
        # Find exact or partial match
        import re
        matches = re.findall(r'"([^"]+)":\s*"([^"]+)"', content)
        query_lower = query.lower()
        for k, v in matches:
            if k.lower() == query_lower:
                print(f"dork: {v}")
                return
        
        # Try partial match
        for k, v in matches:
            if query_lower in k.lower():
                print(f"dork (partial match '{k}'): {v}")
                return

    print(f"dork: I don't have specific knowledge about '{query}' yet.")
    print(f"[*] Opening browser for full intelligence interface...")
    webbrowser.open(URL)

def list_merges(limit: int):
    if not is_server_running():
        if not start_server():
            print("[-] Failed to start server. Check server.log")
            return

    try:
        conn = http.client.HTTPConnection("localhost", PORT)
        conn.request("GET", f"/api/governance/merges?limit={limit}")
        resp = conn.getresponse()
        if resp.status == 200:
            data = json.loads(resp.read().decode())
            merges = data.get("merges", [])
            print(f"--- Recent DEVADAAD Merges ({len(merges)}) ---")
            for merge in merges:
                payload = merge.get("payload", {})
                pr_id = payload.get("pr_id", "Unknown PR")
                sha = payload.get("merge_sha", "")[:8]
                ts = merge.get("timestamp_utc", "")[:19].replace("T", " ")
                tier_m = "PASS" if payload.get("tier_m_working_code") else "FAIL"
                color = "\033[92m" if tier_m == "PASS" else "\033[91m"
                reset = "\033[0m"
                print(f"[{ts}] {pr_id} | SHA: {sha} | Tier M: {color}{tier_m}{reset}")
        else:
            print(f"[-] Failed to fetch merges. HTTP {resp.status}")
    except Exception as e:
        print(f"[-] Error fetching merges: {e}")

def main():
    parser = argparse.ArgumentParser(description="dork — ADAADinside™ Developer Intelligence")
    parser.add_argument("--status", action="store_true", help="Show server and gate status")
    parser.add_argument("--knowledge", action="store_true", help="List available knowledge base keys")
    parser.add_argument("--ask", type=str, help="Ask dork a question from the CLI")
    parser.add_argument("--merges", type=int, nargs="?", const=20, help="List recent DEVADAAD merges (default limit: 20)")
    parser.add_argument("--browser", action="store_true", help="Force open browser even with other commands")
    
    args, unknown = parser.parse_known_args()

    if args.status:
        show_status()
        return

    if args.knowledge:
        list_knowledge()
        return

    if args.merges is not None:
        list_merges(args.merges)
        if args.browser:
            webbrowser.open(URL)
        return

    if args.ask:
        ask_dork(args.ask)
        if args.browser:
            webbrowser.open(URL)
        return

    # Default behavior: ensure server is running and open browser
    if not is_server_running():
        if not start_server():
            print("[-] Failed to start server. Check server.log")
            sys.exit(1)
    
    print(f"[*] Opening dork: {URL}")
    webbrowser.open(URL)

if __name__ == "__main__":
    main()
