"""
Dork — Easiest access to ADAADinside™ Developer Intelligence.
Ensures server is running and provides CLI and browser access to Dork.
"""

import os
import subprocess
import sys
import time
import webbrowser
import json
import argparse
import http.client
import re
from pathlib import Path

PORT = int(os.getenv("ADAAD_PORT", "8000"))
URL = f"http://localhost:{PORT}/dork"

def is_server_running():
    import socket
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('127.0.0.1', PORT)) == 0

def start_server():
    print(f"[*] Starting ADAAD unified server on port {PORT}...")
    env = os.environ.copy()
    env["ADAAD_ENV"] = "dev"
    env["ADAAD_PORT"] = str(PORT)
    env["ADAAD_HOST"] = "0.0.0.0"
    popen_kwargs = {
        "env": env,
    }
    if os.name == "nt":
        create_new_process_group = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", None)
        if create_new_process_group is not None:
            popen_kwargs["creationflags"] = create_new_process_group
    else:
        popen_kwargs["start_new_session"] = True
    with open("server.log", "a") as log_file:
        proc = subprocess.Popen(
            [sys.executable, "server.py"],
            stdout=log_file,
            stderr=log_file,
            **popen_kwargs,
        )

    probe_attempts = 15
    probe_interval_seconds = 1
    last_probe_error = "No probe attempt performed."
    for attempt in range(1, probe_attempts + 1):
        try:
            conn = http.client.HTTPConnection("localhost", PORT, timeout=1)
            conn.request("GET", "/api/health")
            response = conn.getresponse()
            if response.status == 200:
                print("[+] Server is live.")
                return True
            last_probe_error = f"/api/health returned HTTP {response.status}"
        except Exception as exc:
            last_probe_error = f"{type(exc).__name__}: {exc}"
        finally:
            try:
                conn.close()
            except Exception:
                pass

        return_code = proc.poll()
        if return_code is not None:
            print(
                "[-] Server startup failed before becoming reachable "
                f"(attempt {attempt}/{probe_attempts}); process exited with code {return_code}."
            )
            print(f"[-] Final failure reason: {last_probe_error}")
            return False

        time.sleep(probe_interval_seconds)

    total_wait_seconds = probe_attempts * probe_interval_seconds
    print(
        "[-] Server startup timeout: "
        f"unreachable after {probe_attempts} probes over {total_wait_seconds}s."
    )
    print(f"[-] Final failure reason: {last_probe_error}")
    return False

def get_api_health():
    try:
        conn = http.client.HTTPConnection("localhost", PORT)
        conn.request("GET", "/api/health")
        resp = conn.getresponse()
        if resp.status == 200:
            return json.loads(resp.read().decode())
    except:
        pass
    return None

def fetch_adaad_state():
    state = {}
    try:
        conn = http.client.HTTPConnection("localhost", PORT)
        # 1. Health
        conn.request("GET", "/api/health")
        r1 = conn.getresponse()
        if r1.status == 200: state["health"] = json.loads(r1.read().decode())
        
        # 2. Governance
        conn.request("GET", "/api/governance/health")
        r2 = conn.getresponse()
        if r2.status == 200: state["governance"] = json.loads(r2.read().decode())
        
        # 3. Readiness
        conn.request("GET", "/api/readiness")
        r3 = conn.getresponse()
        if r3.status == 200: state["readiness"] = json.loads(r3.read().decode())
    except:
        pass
    return state

def show_status():
    print(f"--- dork status ---")
    running = is_server_running()
    print(f"Server: {'RUNNING' if running else 'STOPPED'}")
    if running:
        health = get_api_health()
        if health:
            print(f"Version: {health.get('version', 'unknown')}")
            print(f"Gate: {'LOCKED' if health.get('gate', {}).get('locked') else 'OPEN'}")
            print(f"UI: {'PRESENT' if health.get('ui_present') else 'MISSING'}")
        print(f"URL: {URL}")
    else:
        print(f"Run 'dork' without arguments to start the server.")

def list_knowledge():
    kb_path = Path("ui/developer/ADAADdev/dork_knowledge_base.js")
    if not kb_path.exists():
        print("[-] Knowledge base not found.")
        return

    content = kb_path.read_text()
    import re
    keys = re.findall(r'"([^"]+)":', content)
    print("--- dork knowledge keys ---")
    for k in sorted(keys):
        print(f" - {k}")


def gpg_ceremony():
    print("[*] Initiating Dork GPG Ceremony Priest...")
    print("--- ADAAD Track B Release Ritual ---")
    print("1. Verifying environment...")
    import os
    if not os.getenv("GPG_TTY"):
        print("[-] WARN: GPG_TTY not set. Run: export GPG_TTY=$(tty)")
    else:
        print("[+] GPG_TTY verified.")
    print("2. Checking Readiness Score...")
    state = fetch_adaad_state()
    readiness = state.get("readiness", {}).get("readiness_score", 0)
    if readiness >= 0.90:
        print(f"[+] Readiness {readiness:.2f} is PASS.")
    else:
        print(f"[-] WARN: Readiness {readiness:.2f} is below 0.90 GA threshold.")
    print("\n[ACTION REQUIRED] Run the following to cryptographically sign the epoch:")
    print("git tag -s v9.99.0 -m \"Phase Promotion\"")
    print("git push origin v9.99.0")
    print("\nMay the ledger remain immutable.")

